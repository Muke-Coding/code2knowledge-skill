{
  "name": "@code2knowledge/kernel",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Code2Knowledge shared knowledge contracts, templates and analysis specifications.",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "assets/",
    "references/",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node --check src/index.mjs && node --check src/contract.mjs",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 src/index.d.mts",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muke-Coding/code2knowledge-skill.git",
    "directory": "packages/reverse-kernel"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
